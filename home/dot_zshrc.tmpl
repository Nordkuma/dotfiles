# config
export KEYTIMEOUT=1
export HISTSIZE=10000
export SAVEHIST=10000
export LS_COLORS='di=34:ln=35:so=32:pi=33:ex=31:bd=46;34:cd=43;34:su=41;30:sg=46;30:tw=42;30:ow=43;30'
autoload -Uz compinit
if [[ -n "$HOME"/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
setopt always_to_end auto_menu auto_param_keys complete_in_word correct interactive_comments list_types
setopt append_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks share_history
setopt no_beep prompt_subst
zstyle ':completion:*' completer _complete _approximate
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:default' menu select=1
{{- if eq .chezmoi.os "darwin" }}
zstyle ':completion:*:sudo:*' command-path ${(s.:.)PATH}
{{- else }}
zstyle ':completion:*:sudo:*' command-path /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin
{{- end }}

# hooks
source "$HOME/.config/zsh/hooks.zsh"

# keybindings
source "$HOME/.config/zsh/keybindings.zsh"

# plugins
source "$HOME/.config/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOME/.config/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# tools
source "$HOME/.config/zsh/tools.zsh"

# commands
source "$HOME/.config/zsh/commands.zsh"
